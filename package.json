{
  "name": "old-swedish-dictionary-next",
  "description": "Next.js implementation of Medieval Swedish Dictionary by K.F. Söderwall",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/stscoundrel/old-swedish-dictionary-next.git",
  "author": "stscoundrel <silvennoinen.sampo@gmail.com>",
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "prettier src tests --check",
    "fix": "prettier src tests --write",
    "jest": "jest --verbose --runInBand --passWithNoTests",
    "test:unit": "yarn jest",
    "test:coverage": "jest --coverage tests src/components --coverageThreshold='{\"global\":{\"statements\":\"90\", \"functions\":\"85\", \"branches\":\"75\", \"lines\":\"90\"}}'",
    "create:alphabet": "ts-node scripts/output-alphabet.ts",
    "revalidate": "ts-node scripts/revalidate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "abbreviatrix": "^1.0.8",
    "markari": "^1.0.7",
    "next": "^16.1.7",
    "next-pwa": "^5.6.0",
    "old-swedish-dictionary": "^1.0.4",
    "old-swedish-dictionary-abbreviations": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reset-css": "^5.0.2",
    "riimut": "^0.9.1",
    "sass": "^1.97.3",
    "scandinavian-dictionary-crosslinker": "^0.7.0",
    "sharp": "^0.34.5",
    "sitemap": "^7.1.1",
    "slugify": "^1.6.6",
    "teljari": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.17.2",
    "@types/react": "^18.3.24",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next-router-mock": "^0.9.13",
    "node-mocks-http": "^1.17.2",
    "prettier": "3.9.9",
    "react-test-renderer": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.1.0"
}
