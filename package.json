{
  "name": "old-swedish-dictionary-next",
  "description": "Next.js implementation of Medieval Swedish Dictionary by K.F. S\u00f6derwall",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/stscoundrel/old-swedish-dictionary-next.git",
  "author": "stscoundrel <silvennoinen.sampo@gmail.com>",
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "prettier src tests --check",
    "fix": "prettier src tests --write",
    "jest": "jest --verbose --runInBand --passWithNoTests",
    "test:unit": "npm run jest --",
    "test:coverage": "jest --coverage tests src/components --coverageThreshold='{\"global\":{\"statements\":\"90\", \"functions\":\"85\", \"branches\":\"75\", \"lines\":\"90\"}}'",
    "create:alphabet": "tsx scripts/output-alphabet.ts",
    "revalidate": "tsx scripts/revalidate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "abbreviatrix": "^1.0.8",
    "markari": "^1.0.7",
    "next": "16.4.0",
    "old-swedish-dictionary": "^1.0.4",
    "old-swedish-dictionary-abbreviations": "^0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reset-css": "^5.0.2",
    "riimut": "^0.9.1",
    "sass": "^1.105.1",
    "scandinavian-dictionary-crosslinker": "^0.7.0",
    "serwist": "^9.5.13",
    "sitemap": "^7.1.1",
    "slugify": "^1.6.6",
    "teljari": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "next-router-mock": "^0.9.13",
    "node-mocks-http": "^1.17.2",
    "prettier": "3.9.9",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
